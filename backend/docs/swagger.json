    "definitions": {
        "api.CreateDeviceRequest": {
            "type": "object",
            "required": [
                "mac_address",
                "name"
            ],
            "properties": {
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "mac_address": {
                    "type": "string",
                    "example": "00:11:22:33:44:55"
                },
                "name": {
                    "type": "string",
                    "example": "Temperature Sensor 1"
                },
                "type": {
                    "type": "string",
                    "example": "Sensor"
                }
            }
        },
        "api.CreateTelemetryRequest": {
            "type": "object",
            "required": [
                "data_type",
                "device_id"
            ],
            "properties": {
                "data_type": {
                    "type": "string",
                    "example": "Temperature"
                },
                "device_id": {
                    "type": "integer",
                    "example": 1
                },
                "recorded_at": {
                    "description": "可選，如果沒有提供則使用當前時間",
                    "type": "string",
                    "example": "2024-01-01T00:00:00Z"
                },
                "value": {
                    "type": "number",
                    "example": 25.5
                }
            }
        },
        "api.CreateUserRequest": {
            "type": "object",
            "required": [
                "email",
                "username"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "john@example.com"
                },
                "username": {
                    "type": "string",
                    "example": "john_doe"
                }
            }
        },
        "api.DeviceResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "is_active": {
                    "type": "boolean"
                },
                "mac_address": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "telemetries": {
                    "description": "這裡只放入 DTO 版本的 Telemetry",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/api.TelemetryResponse"
                    }
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "api.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "api.PatchDeviceRequest": {
            "type": "object",
            "properties": {
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "mac_address": {
                    "type": "string",
                    "example": "00:11:22:33:44:55"
                },
                "name": {
                    "description": "使用指針，nil 表示不更新",
                    "type": "string",
                    "example": "Temperature Sensor 1"
                },
                "type": {
                    "type": "string",
                    "example": "Sensor"
                }
            }
        },
        "api.PatchTelemetryRequest": {
            "type": "object",
            "properties": {
                "data_type": {
                    "type": "string",
                    "example": "Temperature"
                },
                "device_id": {
                    "description": "使用指針，nil 表示不更新",
                    "type": "integer",
                    "example": 1
                },
                "recorded_at": {
                    "type": "string",
                    "example": "2024-01-01T00:00:00Z"
                },
                "value": {
                    "type": "number",
                    "example": 25.5
                }
            }
        },
        "api.TelemetryResponse": {
            "type": "object",
            "properties": {
                "data_type": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "recorded_at": {
                    "type": "string"
                },
                "value": {
                    "type": "number"
                }
            }
        },
        "api.UpdateDeviceRequest": {
            "type": "object",
            "required": [
                "mac_address",
                "name"
            ],
            "properties": {
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "mac_address": {
                    "type": "string",
                    "example": "00:11:22:33:44:55"
                },
                "name": {
                    "type": "string",
                    "example": "Temperature Sensor 1"
                },
                "type": {
                    "type": "string",
                    "example": "Sensor"
                }
            }
